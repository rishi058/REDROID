+    dependsOn("normalizeModuleTextFiles")
     val moduleFolder = project.rootDir.resolve("module")
     val zygiskBuildDir = project.rootDir.resolve("zygisk/build")
     val classesJar = zygiskBuildDir.resolve("intermediates/dex/release/minifyReleaseWithR8/classes.dex")
@@ -27,6 +28,35 @@ tasks.register("copyZygiskFiles") {
     }
 }
 
+tasks.register("normalizeModuleTextFiles") {
+    description = "Normalize KernelSU module text files to UTF-8/LF"
+
+    val moduleFolder = project.rootDir.resolve("module")
+    inputs.dir(moduleFolder)
+    outputs.dir(moduleFolder)
+    outputs.upToDateWhen { false }
+
+    doLast {
+        moduleFolder.walkTopDown()
+            .filter { file ->
+                file.isFile && (
+                    file.extension in setOf("sh", "prop") ||
+                        file.name in setOf("update-binary", "updater-script")
+                    )
+            }
+            .forEach { file ->
+                val original = file.readText(Charsets.UTF_8)
+                val normalized = original
+                    .removePrefix("\uFEFF")
+                    .replace("\r\n", "\n")
+                    .replace("\r", "\n")
+                if (normalized != original) {
+                    file.writeText(normalized, Charsets.UTF_8)
+                }
+            }
+    }
+}
+
 tasks.register<Zip>("zip") {
     description = "Zip Module"
     dependsOn("copyZygiskFiles")
