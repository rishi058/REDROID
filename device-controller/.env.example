REQUIRE_API_KEYS=true
ALLOW_INSECURE_LOCAL=false
API_KEY_ADMIN=replace-with-a-random-32-character-hex-key
API_KEY_BREAK_GLASS=replace-with-a-separate-random-key

DEFAULT_ADB_SERIAL=redroid:5555
ADB_TIMEOUT_SECONDS=10
MAX_OUTPUT_BYTES=262144
ALLOWED_PACKAGES=com.example.app
ALLOWED_APP_COMPONENTS=com.example.app=com.example.app/.MainActivity
ENABLE_MUTATIONS=false
ENABLE_KERNEL_DIAGNOSTICS=false

DOCS_MODE=public
AUDIT_DATABASE=/data/audit.db
AUDIT_RETENTION_DAYS=90

ENABLE_GUI=false
GUI_ORIGIN=https://controller.example.com
GUI_COOKIE_SECURE=true
GUI_LEASE_SECONDS=1800
GUI_MAX_VIEWERS=3
GUI_WORKER_COMMAND=node gui/worker/dist/index.js
TOUCH_INJECTION_MODE=adb
ANDROID_DISPLAY_WIDTH=720
ANDROID_DISPLAY_HEIGHT=1280

CONTROLLER_PORT=3003
HOST_ADB_PORT=5557
REDROID_IMAGE=redroid/redroid:14.0.0-latest
